# ---------------------------------------------------------------------------
# オンプレサーバー監視の設定
# ---------------------------------------------------------------------------
# このファイルを同じフォルダに hosts.toml としてコピーして編集してください。
#   cp config/hosts.toml.example config/hosts.toml
#
# 各ホストに exporter を入れ、IP・PC名・系統図の表示名を指定します。
#   os = "linux"   → node_exporter        (既定ポート 9100)
#   os = "windows" → windows_exporter     (既定ポート 9182)
#
# port を省略すると os に応じた既定ポートを使います。
# group を省略すると "オンプレサーバー" にまとめられます。
# ---------------------------------------------------------------------------

[[host]]
ip = "192.168.3.3"
hostname = "WIN-DESK01"   # 実際のPC名（任意）
display = "Main PC"       # 系統図に表示する名前
os = "windows"
# port = 9182
group = "オンプレサーバー"

# [[host]]
# ip = "192.168.3.50"
# hostname = "ubuntu-srv"
# display = "ファイルサーバー"
# os = "linux"
# port = 9100
# group = "オンプレサーバー"
