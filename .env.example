# Proxmox ホスト (IPアドレスまたはFQDN、https:// は不要) ※実際の値に変更
PROXMOX_HOST=192.168.1.10

# Proxmox ユーザー (username@realm 形式)
PROXMOX_USER=monitor@pve

# Proxmox API トークン名
PROXMOX_TOKEN_NAME=monitoring

# Proxmox API トークン値
PROXMOX_TOKEN_VALUE=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# SSL証明書の検証 (true または false)
PROXMOX_VERIFY_SSL=false

# パスワード認証を使う場合 (トークンの代わり)
# PROXMOX_PASSWORD=yourpassword

# Google Chat Webhook URL (通知機能を使う場合に設定)
# GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/XXXXX/messages?key=...&token=...

# アバターのセリフ生成に使う Ollama (VRMが定期的に吹き出しでコメントする)
# 両方設定したときのみ有効。未設定ならセリフ機能はオフ（監視には影響しない）。
# OLLAMA_URL=http://<OllamaのPCのIP>:11434
# OLLAMA_MODEL=<pull済みモデル名>   # 例: llama3.2 / gemma3 / qwen2.5
# セリフがバリデーション（英語・前置き・長文などを弾く）に落ちたときの作り直し回数
# OLLAMA_MAX_ATTEMPTS=3
# 平常時に雑談を話す割合の重み（状況報告=50 に対する比。0 で報告だけになる）
# AVATAR_CHAT_WEIGHT=50
